{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "src/*-1.tsx",
    "src/*-2.tsx",
    "src/StudioDashboard.tsx",
    "src/StudiosDirectory.tsx",
    "src/VideoPlayerModal-1.tsx",
    "src/*.txt",
    "src/components/*-1.tsx",
    "src/components/*-2.tsx",
    "src/components/*.txt",
    "src/services/*-1.ts"
  ]
}
